LASTFM_API_KEY=your_api_key_here
LASTFM_API_SECRET=your_api_secret_here

# Optional second scrobble destination: a self-hosted Adolar Scrobbler
# instance (https://github.com/noyse27/adolar-scrobbler). API_ROOT is that
# instance's 2.0 Web Service URL (e.g. https://scrobbler.example.com/2.0/);
# API_KEY/SECRET are the app credentials shown to admins in its own
# Settings page. Leave unset to not offer it at all.
ADOLAR_SCROBBLER_API_ROOT=
ADOLAR_SCROBBLER_API_KEY=
ADOLAR_SCROBBLER_API_SECRET=

SECRET_KEY=change_me_to_a_long_random_hex_value
BACKUP_HOST_PATH=/volumeUSB1/usbshare/adolarDBbackup
BACKUP_AUTO_ENABLED=true
BACKUP_HOUR=3
BACKUP_RETENTION=7
TZ=Europe/Berlin
