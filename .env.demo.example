# Used by docker-compose.demo.yml. Copy to .env.demo and run:
#   docker compose -p adolar-demo --env-file .env.demo -f docker-compose.demo.yml up -d --build
# See docs/demo.md for the full write-up of what demo mode does and why.

# Not strictly required to boot, but without it every restart invalidates
# every session (the app falls back to a random per-process secret).
# Generate with: openssl rand -hex 32
SECRET_KEY=

# How often the demo database resets (wipes every account/track/playlist
# and reseeds the fixed demo admin + demo listener). Minutes, clamped to
# [5, 1440] by the backend. Default: 60.
# ADOLAR_DEMO_RESET_MINUTES=60

# Fixed demo logins, printed on the frontend's own banner - not a secret,
# only override these if you're running more than one demo stack and want
# to tell them apart.
# ADOLAR_DEMO_ADMIN_USERNAME=demo-admin
# ADOLAR_DEMO_ADMIN_PASSWORD=adolar-demo
# ADOLAR_DEMO_USER_USERNAME=demo-hoerer
# ADOLAR_DEMO_USER_PASSWORD=adolar-demo

# Host-side port. Default is deliberately different from docker-compose.yml's
# 15002 so a demo stack can run alongside a real Adolar deployment on the
# same host without any override needed.
# DEMO_HOST_PORT=15012

TZ=Europe/Berlin

# Length (seconds) of each synthetic demo track the "demo-library" one-shot
# service renders on first startup (see demo/generate-library.sh).
# TRACK_DEMO_CLIP_SECONDS=8
